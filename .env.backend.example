# Copia como .env.backend y completa los valores de tu proyecto.
# Este archivo contiene secretos y se mantiene fuera de Git.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080
PORT=8080

# Supabase → Connect → Session pooler (usar usuario, host y puerto indicados allí).
ConnectionStrings__Supabase=Host=POOLER_HOST;Port=5432;Database=postgres;Username=POOLER_USER;Password=CAMBIAR;SSL Mode=Require
Supabase__Url=https://PROJECT_REF.supabase.co
Supabase__InternalUrl=https://PROJECT_REF.supabase.co
Supabase__AnonKey=PEGAR_ANON_KEY_PUBLICA
Supabase__ServiceRoleKey=PEGAR_SERVICE_ROLE_KEY_SECRETA
Supabase__JwtAudience=authenticated
Supabase__ProductBucket=uniflow-images

# Para desarrollo local con Docker; en Render reemplazar ambos por la URL exacta del Web Service web.
App__PublicUrl=http://localhost:8080
AllowedOrigins=http://localhost:8080

Database__MigrateOnStartup=false
Storage__EnsureBucketOnStartup=true
RateLimiting__PublicRequestsPerMinute=30
Swagger__Enabled=true
