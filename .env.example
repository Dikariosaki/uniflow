# Copy this template to .env and fill in your own Supabase project values.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
# Npgsql connection string. Use the exact host/user from Supabase Connect (direct or session pooler).
SUPABASE_DB_CONNECTION="Host=YOUR_DATABASE_HOST;Port=5432;Database=postgres;Username=YOUR_DATABASE_USER;Password=YOUR_DATABASE_PASSWORD;SSL Mode=Require"
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_PRODUCT_BUCKET=uniflow-images
APP_PUBLIC_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:8080
API_BASE_URL=/api
MIGRATE_ON_STARTUP=false
ENSURE_STORAGE_BUCKET_ON_STARTUP=true
PUBLIC_REQUESTS_PER_MINUTE=30
WEB_PORT=8080
API_PORT=8081
SWAGGER_ENABLED=true
# Optional: API-only address when Supabase is reached through a different container hostname.
# SUPABASE_INTERNAL_URL=https://YOUR_PROJECT.supabase.co
